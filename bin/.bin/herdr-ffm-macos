#!/bin/bash
# Build and install Herdr with focus follows mouse on macOS, from the same
# release and patch as pkgrepo's herdr-app-ffm on Linux. Installs
# ~/Applications/Herdr.app with Herdr's own scripts/install-macos. A build from
# source never updates itself; rerun this after pulling a new patch.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo "macOS only; on Linux install pkgrepo's herdr-app-ffm" >&2; exit 1; }

pkg=$HOME/src/archlinux/pkgrepo/packages/herdr-app-ffm
src=$HOME/src/herdr-app
work=$HOME/.cache/herdr-ffm/herdr-app
# Herdr v0.1.15 and Ghostty's build (only Zig 0.16.x), as in the PKGBUILD.
commit=9950887361af3ba218b9ce7a347cb8ec7b66c71d
zig_ver=0.16.0
zig_sha=b23d70deaa879b5c2d486ed3316f7eaa53e84acf6fc9cc747de152450d401489
# ziglang.org's public minisign key, kept in the PKGBUILD.
zig_key=$(sed -n 's/^_zigkey=//p' "$pkg/PKGBUILD")

zig_dir=$HOME/.cache/herdr-ffm/zig-aarch64-macos-$zig_ver
if [[ ! -x $zig_dir/zig ]]; then
  tarball=$zig_dir.tar.xz
  mkdir -p "$(dirname "$zig_dir")"
  curl -fsSLo "$tarball" "https://ziglang.org/download/$zig_ver/zig-aarch64-macos-$zig_ver.tar.xz"
  echo "$zig_sha  $tarball" | shasum -a 256 -c -
  if command -v minisign >/dev/null; then
    curl -fsSLo "$tarball.minisig" "https://ziglang.org/download/$zig_ver/zig-aarch64-macos-$zig_ver.tar.xz.minisig"
    minisign -Vm "$tarball" -P "$zig_key"
  fi
  tar -xf "$tarball" -C "$(dirname "$zig_dir")"
fi

git -C "$src" fetch -q origin
git -C "$src" worktree remove --force "$work" 2>/dev/null || true
mkdir -p "$(dirname "$work")"
git -C "$src" worktree add -q --detach "$work" "$commit"
git -C "$work" submodule update -q --init --depth 1 vendor/ghostty
git -C "$work" apply "$pkg/focus-follows-mouse.patch"

export ZIG=$zig_dir/zig
cargo test --manifest-path "$work/Cargo.toml" --release --locked --bin herdr-app -- follow_mouse settings::tests
bash "$work/scripts/install-macos"
