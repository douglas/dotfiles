#!/usr/bin/env bash
# Give this Mac the Omarchy theme the desktop is using right now.
#
#   omarchy-theme-pull [host]      default host: desktop
#
# Omarchy renders the current theme into ~/.local/state/omarchy/current
# (ghostty.conf, btop.theme, neovim.lua, colors.toml, the background). This
# copies that folder from the Linux machine to the same place here. The Mac's
# Ghostty and Neovim configs read it the way they do on Linux; this script
# then does what Hyprland and Omarchy's bar do there: the btop theme link,
# the wallpaper and dark mode.
# Rerun it after switching themes on Linux.
set -euo pipefail

[[ $OSTYPE == darwin* ]] || { echo "omarchy-theme-pull: macOS only (Linux has the theme already)" >&2; exit 1; }
export PATH="/opt/homebrew/bin:$PATH"

host=${1:-desktop}
state="$HOME/.local/state/omarchy/current"
theme="$state/theme"
mkdir -p "$state"

# -L: the background (and the theme folder itself) are links on Linux.
rsync -aL --delete "$host:.local/state/omarchy/current/" "$state/"
echo "theme: $(<"$state/theme.name") (from $host)"

color() { sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"#([0-9a-fA-F]{6})\".*/\1/p" "$theme/colors.toml" | tr 'A-F' 'a-f'; }

# btop: the shared btop.conf picks the "current" theme, as Omarchy links it.
mkdir -p "$HOME/.config/btop/themes"
ln -sfn "$theme/btop.theme" "$HOME/.config/btop/themes/current.theme"

# Wallpaper: macOS can't use .webp, so keep a PNG copy.
wallpaper="$HOME/Library/Application Support/omarchy/background.png"
mkdir -p "$(dirname "$wallpaper")"
sips -s format png "$state/background" --out "$wallpaper" >/dev/null
osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$wallpaper\""

# ZapFast and Spotifast: what their Omarchy hooks do on Linux, into the macOS
# themes folders. Pick "omarchy" once in each app's Settings → Appearance; a
# running app picks up changes after a restart.
for app in zapfast spotifast; do
  [[ -f "$theme/$app.json" ]] || continue
  dir="$HOME/Library/Application Support/me.paolino.$app/themes"
  mkdir -p "$dir"
  cp "$theme/$app.json" "$dir/omarchy.json"
done

# Claude Code: the Omarchy theme, as omarchy-theme-set-claude installs it on
# Linux. Pick it once with /theme (custom:omarchy).
if [[ -f "$theme/claude.json" ]]; then
  mkdir -p "$HOME/.claude/themes"
  cp "$theme/claude.json" "$HOME/.claude/themes/omarchy.json"
fi

# T3 Code: the Omarchy theme, as omarchy-theme-set-t3code installs it on
# Linux, selected with its CLI (Settings → About installs `t3`).
if [[ -f "$theme/t3code.json" ]]; then
  mkdir -p "$HOME/.t3/userdata/themes"
  cp "$theme/t3code.json" "$HOME/.t3/userdata/themes/omarchy.json"
  t3="$(command -v t3 || echo "$HOME/.local/bin/t3")"
  [[ -x "$t3" ]] && "$t3" theme set omarchy >/dev/null 2>&1 || true
fi

# Sublime settings aren't strict JSON (comments, trailing commas), so set one
# "key": "value" line in place, or add it after the opening brace.
sublime_set() {
  local file="$1" key="$2" value="$3"
  [[ -f "$file" ]] || printf '{\n}\n' >"$file"
  if grep -q "\"$key\"[[:space:]]*:" "$file"; then
    sed -i '' -E "s|(\"$key\"[[:space:]]*:[[:space:]]*)\"[^\"]*\"|\1\"$value\"|" "$file"
  else
    sed -i '' -E "1,/\{/s|\{|{\\
	\"$key\": \"$value\",|" "$file"
  fi
}

# Sublime Merge: the Omarchy theme and color scheme, as the Linux theme-set
# hook installs them.
merge="$HOME/Library/Application Support/Sublime Merge/Packages"
merge_theme="$theme/sublime-merge-omarchy-dark.sublime-theme"
[[ -f "$theme/light.mode" ]] && merge_theme="$theme/sublime-merge-omarchy-light.sublime-theme"
if [[ -d "$merge" && -f "$merge_theme" ]]; then
  mkdir -p "$merge/Theme - Omarchy" "$merge/User"
  cp "$merge_theme" "$merge/Theme - Omarchy/Omarchy.sublime-theme"
  cp "$theme/sublime-merge-omarchy.sublime-color-scheme" "$merge/Theme - Omarchy/Omarchy.sublime-color-scheme"
  for key in theme light_theme dark_theme; do
    sublime_set "$merge/User/Preferences.sublime-settings" "$key" "Omarchy.sublime-theme"
  done
  for key in color_scheme light_color_scheme dark_color_scheme; do
    sublime_set "$merge/User/Preferences.sublime-settings" "$key" \
      "Packages/Theme - Omarchy/Omarchy.sublime-color-scheme"
  done
fi

# Sublime Text: the Catppuccin package's scheme for the Catppuccin themes.
case "$(<"$state/theme.name")" in
  catppuccin) scheme="Catppuccin Mocha.sublime-color-scheme" ;;
  catppuccin-latte) scheme="Catppuccin Latte.sublime-color-scheme" ;;
  *) scheme="" ;;
esac
text="$HOME/Library/Application Support/Sublime Text/Packages/User/Preferences.sublime-settings"
[[ -n "$scheme" && -f "$text" ]] && sublime_set "$text" color_scheme "$scheme"

# Light or dark, as the theme says.
dark=true
[[ "$(sed -nE 's/^mode[[:space:]]*=[[:space:]]*"(.*)"/\1/p' "$theme/colors.toml")" == light ]] && dark=false
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark"

echo "Applied. Reload Ghostty's config (cmd+shift+,); Neovim picks it up in new sessions."
