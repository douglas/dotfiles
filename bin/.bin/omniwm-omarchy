#!/usr/bin/env python3
"""Give OmniWM Omarchy's look and keys (Option stands in for Super).

  omniwm-omarchy [settings.toml]   default: ~/.config/omniwm/settings.toml

Quit OmniWM first: it rewrites settings.toml itself. Edits the text in place,
so the keys this leaves alone stay as OmniWM wrote them, and fails loudly if a
key it expects is missing. Install/macOS/install.sh desktop runs it.
"""

import os
import re
import sys

path = (
    sys.argv[1]
    if len(sys.argv) > 1
    else os.path.expanduser("~/.config/omniwm/settings.toml")
)
with open(path) as f:
    s = f.read()


def setting(section, key, value):
    """Set key = value inside [section] (up to the next header)."""
    global s
    m = re.search(
        rf"^\[{re.escape(section)}\]\n(.*?)(?=^\[)", s, re.DOTALL | re.MULTILINE
    )
    if not m:
        sys.exit(f"missing section [{section}]")
    body, n = re.subn(
        rf"^{re.escape(key)} = .*$", f"{key} = {value}", m.group(1), flags=re.MULTILINE
    )
    if n != 1:
        sys.exit(f"missing {section}.{key}")
    s = s[: m.start(1)] + body + s[m.end(1) :]


def hotkey(action, binding):
    global s
    s, n = re.subn(
        rf'^binding = "[^"]*"\nid = "{re.escape(action)}"$',
        f'binding = "{binding}"\nid = "{action}"',
        s,
        flags=re.MULTILINE,
    )
    if n != 1:
        sys.exit(f"missing hotkey {action}")


# Hyprland's layout, Omarchy's gaps (gaps_in 5 per side, gaps_out 10), focus
# follows the mouse (follow_mouse = 1).
setting("general", "defaultLayoutType", '"dwindle"')
setting("gaps", "size", "10.0")
# A lone window fills the outer-gap frame only with fullscreenUsesOuterGaps
# (otherwise it covers the whole screen). The bar reserves its own height, and
# the top gap counts from the screen top, the menu bar (27.5) included. With
# two or more windows OmniWM 0.8 adds the inner gap at the edges as well
# (reported upstream), so those get 20.
setting("gaps", "fullscreenUsesOuterGaps", "true")
setting("gaps.outer", "top", "37.5")
setting("gaps.outer", "left", "10.0")
setting("gaps.outer", "right", "10.0")
setting("gaps.outer", "bottom", "10.0")
setting("focus", "followsMouse", "true")
# Omarchy's launcher pops up at once. OmniWM's palette fades in as a search
# bar and then grows into the list (two steps that look like two launches);
# only the global switch turns that off, window moves included.
setting("general", "animationsEnabled", "false")
# OmniWM's bar (OmniShell, laid out below) replaces the menu bar; JankyBorders
# draws the themed borders.
setting("workspaceBar", "enabled", "true")
setting("borders", "enabled", "false")
# OmniWM's hidden bar conceals menu bar icons, which needs Full Disk Access.
setting("hiddenBar", "enabled", "false")

# Hardening for a managed Mac (see the OmniWM review): Homebrew updates it,
# nothing drives it over IPC, and no widget sends the playing song to
# lrclib.net. Weather (Open-Meteo, the city below) stays for the bar.
setting("general", "updateChecksEnabled", "false")
setting("general", "ipcEnabled", "false")
setting("shellPermissions.services", "lyrics", "false")

# Omarchy's tiling keys (default/hypr/bindings/tiling.lua), Super -> Option.
hotkey("closeFocusedWindow", "Option+W")  # SUPER+W
hotkey("toggleSplit", "Option+J")  # SUPER+J
hotkey("toggleColumnTabbed", "Unassigned")  # frees Option+T
hotkey("toggleFocusedWindowFloating", "Option+T")  # SUPER+T
hotkey("toggleFullscreen", "Option+F")  # SUPER+F
hotkey("focusPrevious", "Unassigned")  # frees Option+Tab
hotkey("switchWorkspace.next", "Option+Tab")  # SUPER+TAB
hotkey("switchWorkspace.previous", "Option+Shift+Tab")  # SUPER+SHIFT+TAB
hotkey("resizeContainerPrimarySpan.shrink", "Unassigned")
hotkey("resizeContainerPrimarySpan.grow", "Unassigned")
hotkey("resizeFocusedWindow.shrink", "Option+Minus")  # SUPER+MINUS
hotkey("resizeFocusedWindow.grow", "Option+Equal")  # SUPER+EQUAL
# Free Omarchy's app keys for macOS Shortcuts: SUPER+SHIFT+B browser and
# SUPER+SHIFT+F file manager.
hotkey("balanceSizes", "Unassigned")
hotkey("toggleContainerFullPrimarySpan", "Unassigned")
# Super+Space is Omarchy's launcher: OmniWM's command palette in launcher
# mode (apps, saved commands, CLI tools), in place of Spotlight's shortcut.
hotkey("openCommandPalette.applications", "Command+Space")

with open(path, "w") as f:
    f.write(s)
print(f"omniwm-omarchy: updated {path}")

# The bar, laid out like Omarchy's (~/.config/omarchy/shell.json on Linux):
# menu and workspaces left; indicators, clock, other cities and weather in the
# middle; keyboard, stats, bluetooth, network, audio, battery and power right.
# The palette is the one omarchy-theme-pull writes from the desktop's theme.
SHELL_TOML = """\
# Written by omniwm-omarchy: OmniShell laid out like the Omarchy bar.
profile = "default"

[weather]
city = "Montreal"
units = "celsius"
refresh = 15

[profiles.default]
theme = "omarchy"
leading = ["apple-menu", "workspaces"]
center = ["privacy", "clock", "world-clock", "weather"]
trailing = ["input-source", "system-stats", "bluetooth", "wifi", "volume", "battery", "control-center"]

[profiles.default.workspaceBar]
height = 32
barFill = "elevatedSurface"

[profiles.default.widgets.workspaces]
indicator = "numbers"

[profiles.default.widgets.world-clock]
zones = [{ label = "San Francisco", zone = "America/Los_Angeles" }]
bar = 1
"""
shell = os.path.join(os.path.dirname(path), "shell", "shell.toml")
os.makedirs(os.path.dirname(shell), exist_ok=True)
with open(shell, "w") as f:
    f.write(SHELL_TOML)
print(f"omniwm-omarchy: wrote {shell}")
