[Unit]
Description=xremap key remapper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/omarchy/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/xremap \
  --mouse \
  --watch=device \
  --allow-launch true \
  --device "Keychron Keychron Q11" \
  --device "Keychron Keychron Q11 Keyboard" \
  --device "Keychron Keychron Q11 Consumer Control" \
  --device "Keychron Keychron Q11 Mouse" \
  --device "Logitech MX Vertical Advanced Ergonomic Mouse" \
  %h/.config/xremap/config.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
