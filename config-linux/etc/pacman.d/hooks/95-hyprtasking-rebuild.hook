[Trigger]
Operation = Upgrade
Type = Package
Target = hyprland
Target = aquamarine
Target = hyprutils
Target = hyprgraphics
Target = hyprcursor
Target = hyprlang

[Action]
Description = Rebuilding Hyprtasking for the updated Hyprland headers...
When = PostTransaction
Depends = hyprland
Depends = meson
Exec = /usr/local/lib/omarchy-rebuild-hyprtasking
