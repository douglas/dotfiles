#!/usr/bin/env bash
# Open a Ghostty tab with a shell on every home machine, in four equal quarters,
# like herdr-app's and kitty's Ctrl+K \:
#   desktop | t1g
#   --------+-----
#   mbp16   | t14s
#
# macOS only: Ghostty's AppleScript dictionary can split a terminal and give the
# new split a command; its keybinds and Linux IPC can't. Each terminal runs
# machine-shell (a login shell on its own machine, SSH to the others).
# Ghostty's Ctrl+K \ types this command, so run it from a shell prompt.
set -euo pipefail

ms="$HOME/.bin/machine-shell"

osascript - "$ms" <<'APPLESCRIPT'
on run argv
  set ms to item 1 of argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to ms & " desktop"
    if (count of windows) is 0 then new window
    set newTab to new tab in front window with configuration cfg
    set topLeft to focused terminal of newTab
    set command of cfg to ms & " t1g"
    set topRight to split topLeft direction right with configuration cfg
    set command of cfg to ms & " mbp16"
    split topLeft direction down with configuration cfg
    set command of cfg to ms & " t14s"
    split topRight direction down with configuration cfg
    focus topLeft
  end tell
end run
APPLESCRIPT
