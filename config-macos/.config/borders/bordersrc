#!/usr/bin/env bash
# JankyBorders, in the current Omarchy theme's colors: the accent for the
# focused window and Omarchy's grey for the others, as Hyprland draws them.
# omarchy-theme-pull copies the theme here and restarts this.
# Docs: https://github.com/FelixKratz/JankyBorders

colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
accent="$(sed -nE 's/^accent[[:space:]]*=[[:space:]]*"#([0-9a-fA-F]{6})".*/\1/p' "$colors" 2>/dev/null)"

# Window corners from Appearance > Window Corners (omarchy4mac's
# omarchy-appearance): sharp is square, theme and rounded are round.
style=round
[[ "$(cat "$HOME/.config/omarchy/window-corners" 2>/dev/null)" == sharp ]] && style=square

options=(
  style="$style"
  width=5.0
  hidpi=on
  active_color="0xff${accent:-89b4fa}"
  inactive_color=0xaa595959
  background_color=0x00000000
  # Ignore invisible system alert windows (ghost borders on empty workspaces)
  blacklist="UserNotificationCenter"
)

borders "${options[@]}"
