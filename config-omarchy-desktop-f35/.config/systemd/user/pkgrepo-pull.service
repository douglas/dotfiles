# Keep the repo f35 serves current: download new builds from the GitHub
# backup that bin/build uploads from whichever machine built them.
[Unit]
Description=pkgrepo: pull new builds from the backup
After=network-online.target
Wants=network-online.target
OnFailure=pkgrepo-notify@%n.service

[Service]
Type=oneshot
ExecStart=%h/src/archlinux/pkgrepo/bin/sync --pull
