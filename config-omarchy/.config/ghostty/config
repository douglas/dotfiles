# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font
font-family = "CommitMono Nerd Font"
font-style = Regular

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings, mirroring ~/.config/herdr-app/keys.json.
# herdr tab = Ghostty tab, herdr pane = Ghostty split, herdr space = Ghostty window.
# Skipped (no Ghostty equivalent): space.select, pane.swap, agent.*, mods, sidebar, layout.switch, help.

# Text sent to the shell (herdr "terminal" section)
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+f=start_search
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = shift+enter=text:\x1b\r
# Ghostty's default Ctrl+Enter is fullscreen; pass it to the app like Herdr (xremap sends Cmd+Enter as Ctrl+Enter).
keybind = ctrl+enter=unbind
keybind = ctrl+backspace=text:\x17
keybind = ctrl+arrow_left=text:\x1bb
keybind = ctrl+arrow_right=text:\x1bf

# App
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+comma=open_config

# Windows (herdr spaces)
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+page_down=goto_window:next
keybind = ctrl+shift+page_up=goto_window:previous
keybind = shift+f2=prompt_window_title

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = f2=prompt_tab_title
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = alt+bracket_right=next_tab
keybind = alt+bracket_left=previous_tab
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=goto_tab:9
keybind = ctrl+alt+one=goto_tab:1
keybind = ctrl+alt+two=goto_tab:2
keybind = ctrl+alt+three=goto_tab:3
keybind = ctrl+alt+four=goto_tab:4
keybind = ctrl+alt+five=goto_tab:5
keybind = ctrl+alt+six=goto_tab:6
keybind = ctrl+alt+seven=goto_tab:7
keybind = ctrl+alt+eight=goto_tab:8
keybind = ctrl+alt+nine=goto_tab:9

# Splits (herdr panes)
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+z=toggle_split_zoom
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down

# Ctrl+K leader (herdr "ctrl-k ..." chords)
keybind = ctrl+k>h=goto_split:left
keybind = ctrl+k>j=goto_split:down
keybind = ctrl+k>k=goto_split:up
keybind = ctrl+k>l=goto_split:right
keybind = ctrl+k>arrow_left=goto_split:left
keybind = ctrl+k>arrow_right=goto_split:right
keybind = ctrl+k>arrow_up=goto_split:up
keybind = ctrl+k>arrow_down=goto_split:down
keybind = ctrl+k>shift+arrow_right=new_split:right
keybind = ctrl+k>shift+arrow_down=new_split:down
keybind = ctrl+k>shift+arrow_left=new_split:left
keybind = ctrl+k>shift+arrow_up=new_split:up
keybind = ctrl+k>minus=new_split:right
keybind = ctrl+k>equal=new_split:down
keybind = ctrl+k>shift+backslash=new_split:right
keybind = ctrl+k>x=close_surface
keybind = ctrl+k>z=toggle_split_zoom
keybind = ctrl+k>c=new_tab
keybind = ctrl+k>n=next_tab
keybind = ctrl+k>p=previous_tab
keybind = ctrl+k>comma=prompt_tab_title
keybind = ctrl+k>shift+seven=close_tab
keybind = ctrl+k>shift+nine=goto_window:previous
keybind = ctrl+k>shift+zero=goto_window:next
keybind = ctrl+k>r=prompt_window_title
keybind = ctrl+k>ctrl+k=text:\x0b

#keybind = super+control+shift+alt+arrow_down=resize_split:down,100
#keybind = super+control+shift+alt+arrow_up=resize_split:up,100
#keybind = super+control+shift+alt+arrow_left=resize_split:left,100
#keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Focus split on hover
focus-follows-mouse = true

# Slowdown mouse scrolling
#mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Per-machine overrides (font-size, window dimensions, etc.)
config-file = machine
