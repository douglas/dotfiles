#!/bin/bash
#
# Omarchy theme-set hook
#
# Extends theme changes to apps not covered by Omarchy templates:
# Zed, bat, delta, starship, zellij, yazi, bottom, Sublime Merge, Typora
#
# Usage: this hook is called by omarchy-theme-set with the theme name as $1

THEME="$1"
THEME_DIR="$HOME/.config/omarchy/current/theme"
COLORS_TOML="$THEME_DIR/colors.toml"

# ── Theme name mappings ──────────────────────────────────────────────────────
# Map Omarchy theme names to app-specific theme names.
# Apps are skipped for themes without a mapping.

declare -A ZED_THEMES=(
  [catppuccin]="Catppuccin Mocha"
  [catppuccin-latte]="Catppuccin Latte"
  [everforest]="Everforest Dark"
  [gruvbox]="Gruvbox Dark"
  [kanagawa]="Kanagawa"
  [nord]="Nord"
  [ristretto]="Monokai Pro Ristretto"
  [rose-pine]="Rosé Pine Dawn"
  [tokyo-night]="Tokyo Night"
  [flexoki-light]="Flexoki Light"
)

declare -A BAT_THEMES=(
  [catppuccin]="Catppuccin Mocha"
  [catppuccin-latte]="Catppuccin Latte"
  [gruvbox]="gruvbox-dark"
  [nord]="Nord"
  [tokyo-night]="base16"
)

declare -A DELTA_THEMES=(
  [catppuccin]="catppuccin-mocha"
  [catppuccin-latte]="catppuccin-latte"
)

declare -A STARSHIP_PALETTES=(
  [catppuccin]="catppuccin_mocha"
  [catppuccin-latte]="catppuccin_latte"
)

declare -A ZELLIJ_THEMES=(
  [catppuccin]="catppuccin-mocha"
  [catppuccin-latte]="catppuccin-latte"
  [everforest]="everforest-dark"
  [gruvbox]="gruvbox-dark"
  [kanagawa]="kanagawa"
  [nord]="nord"
  [tokyo-night]="tokyo-night"
)

# ── Helpers ──────────────────────────────────────────────────────────────────

sed_inplace() {
  # GNU sed should edit the dotfiles source behind Stow-managed symlinks.
  sed -i --follow-symlinks "$@"
}

update_zed() {
  local theme="${ZED_THEMES[$THEME]}"
  [[ -z "$theme" ]] && return

  local settings="$HOME/.config/zed/settings.json"
  [[ -f "$settings" ]] || return

  # Detect if this is a light theme
  local is_light=false
  [[ -f "$THEME_DIR/light.mode" ]] && is_light=true

  # Handle object format: "theme": { "dark": "...", "light": "..." }
  if grep -q '"dark":' "$settings"; then
    if [[ "$is_light" == true ]]; then
      sed_inplace "s/\"light\": \"[^\"]*\"/\"light\": \"$theme\"/" "$settings"
    else
      sed_inplace "s/\"dark\": \"[^\"]*\"/\"dark\": \"$theme\"/" "$settings"
    fi
  fi

  # Handle flat format: "theme": "Name" (older Zed configs / dotfiles)
  if grep -q '"theme": "[^{]' "$settings"; then
    sed_inplace "s/\"theme\": \"[^\"]*\"/\"theme\": \"$theme\"/" "$settings"
  fi

  sed_inplace "s/\"icon_theme\": \"[^\"]*\"/\"icon_theme\": \"$theme\"/" "$settings"
}

update_bat() {
  local theme="${BAT_THEMES[$THEME]}"
  [[ -z "$theme" ]] && return

  local config="$HOME/.config/bat/config"
  [[ -f "$config" ]] || return

  sed_inplace "s/--theme=\"[^\"]*\"/--theme=\"$theme\"/" "$config"
}

update_delta() {
  local theme="${DELTA_THEMES[$THEME]}"
  [[ -z "$theme" ]] && return

  local config="$HOME/.gitconfig"
  [[ -f "$config" ]] || return

  sed_inplace "s/features = line-numbers decorations [a-z-]*/features = line-numbers decorations $theme/" "$config"
}

update_starship() {
  local palette="${STARSHIP_PALETTES[$THEME]}"
  local config="$HOME/.config/starship.toml"
  [[ -f "$config" ]] || return

  if [[ -n "$palette" ]] && grep -q "^\[palettes\.$palette\]" "$config"; then
    # Use a predefined palette (only if the palette section exists in the config)
    if grep -q "^palette = " "$config"; then
      sed_inplace "s/^palette = .*/palette = '$palette'/" "$config"
    else
      sed_inplace "1i palette = '$palette'" "$config"
    fi
  elif [[ -f "$COLORS_TOML" ]]; then
    # Generate an 'omarchy' palette from the current theme's colors.toml
    generate_starship_palette "$config"
  fi
}

generate_starship_palette() {
  local config="$1"

  # Parse colors.toml into shell variables
  local accent cursor foreground background
  local color0 color1 color2 color3 color4 color5 color6 color7
  local color8 color9 color10 color11 color12 color13 color14 color15

  eval "$(sed 's/ = /=/; s/"//g' "$COLORS_TOML")"

  # Map Catppuccin semantic names to available terminal colors
  local palette_block
  palette_block=$(printf '%s\n' \
    '[palettes.omarchy]' \
    "rosewater = \"$cursor\"" \
    "flamingo = \"$cursor\"" \
    "pink = \"$color5\"" \
    "mauve = \"$color5\"" \
    "red = \"$color1\"" \
    "maroon = \"$color1\"" \
    "peach = \"$color3\"" \
    "yellow = \"$color3\"" \
    "green = \"$color2\"" \
    "teal = \"$color6\"" \
    "sky = \"$color6\"" \
    "sapphire = \"$color4\"" \
    "blue = \"$color4\"" \
    "lavender = \"$color4\"" \
    "text = \"$foreground\"" \
    "subtext1 = \"$color7\"" \
    "subtext0 = \"$color15\"" \
    "overlay2 = \"$color15\"" \
    "overlay1 = \"$color8\"" \
    "overlay0 = \"$color8\"" \
    "surface2 = \"$color8\"" \
    "surface1 = \"$color0\"" \
    "surface0 = \"$color0\"" \
    "base = \"$background\"" \
    "mantle = \"$background\"" \
    "crust = \"$background\"" \
    "purple = \"$color5\"" \
    "accent = \"$accent\"")

  # Remove existing omarchy palette section if present
  if grep -q '^\[palettes\.omarchy\]' "$config"; then
    # Delete from [palettes.omarchy] to the next [section] or end of file
    sed_inplace '/^\[palettes\.omarchy\]/,/^\[/{/^\[palettes\.omarchy\]/d;/^\[/!d}' "$config"
    # Clean up trailing blank lines
    sed_inplace -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$config"
  fi

  # Append the new palette
  printf '\n%s\n' "$palette_block" >> "$config"

  # Switch to the omarchy palette
  if grep -q "^palette = " "$config"; then
    sed_inplace "s/^palette = .*/palette = 'omarchy'/" "$config"
  else
    sed_inplace "1i palette = 'omarchy'" "$config"
  fi
}

update_zellij() {
  local theme="${ZELLIJ_THEMES[$THEME]}"
  [[ -z "$theme" ]] && return

  local config="$HOME/.config/zellij/config.kdl"
  [[ -f "$config" ]] || return

  if grep -q '^theme "' "$config"; then
    sed_inplace "s/^theme \"[^\"]*\"/theme \"$theme\"/" "$config"
  else
    # Add theme line at the top of the file
    sed_inplace "1i theme \"$theme\"" "$config"
  fi
}

deploy_template_output() {
  # Copy a generated template file from omarchy/current/theme/ to its final location
  local src="$THEME_DIR/$1"
  local dest="$2"
  [[ -f "$src" ]] || return
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
}

update_sublime_merge() {
  local package_dir="$HOME/.config/sublime-merge/Packages/Theme - Omarchy"
  local user_dir="$HOME/.config/sublime-merge/Packages/User"
  local color_scheme="Packages/Theme - Omarchy/Omarchy.sublime-color-scheme"
  local theme_src="$THEME_DIR/sublime-merge-omarchy-dark.sublime-theme"

  if [[ -f "$THEME_DIR/light.mode" ]]; then
    theme_src="$THEME_DIR/sublime-merge-omarchy-light.sublime-theme"
  fi

  [[ -f "$theme_src" ]] || return
  [[ -f "$THEME_DIR/sublime-merge-omarchy.sublime-color-scheme" ]] || return
  command -v jq >/dev/null 2>&1 || {
    printf 'Sublime Merge Omarchy theme skipped: jq is required to update Preferences.sublime-settings\n' >&2
    return
  }

  mkdir -p "$package_dir" "$user_dir"
  cp "$theme_src" "$package_dir/Omarchy.sublime-theme"
  cp "$THEME_DIR/sublime-merge-omarchy.sublime-color-scheme" "$package_dir/Omarchy.sublime-color-scheme"

  printf '%s\n' \
    '{' \
    '  "color_scheme": "Packages/Theme - Omarchy/Omarchy.sublime-color-scheme"' \
    '}' >"$user_dir/Diff.sublime-settings"

  local preferences="$user_dir/Preferences.sublime-settings"
  local tmp
  tmp=$(mktemp) || return

  if [[ ! -f "$preferences" ]]; then
    printf '{}\n' >"$preferences"
  fi

  if ! jq \
    --arg color_scheme "$color_scheme" \
    '. + {
      "theme": "Omarchy.sublime-theme",
      "light_theme": "Omarchy.sublime-theme",
      "dark_theme": "Omarchy.sublime-theme",
      "color_scheme": $color_scheme,
      "light_color_scheme": $color_scheme,
      "dark_color_scheme": $color_scheme
    }' "$preferences" >"$tmp"; then
    printf 'Sublime Merge Omarchy theme skipped: Preferences.sublime-settings is not valid JSON\n' >&2
    rm -f "$tmp"
    return
  fi

  mv "$tmp" "$preferences"
}

update_typora() {
  [[ -f "$COLORS_TOML" ]] || return

  local accent foreground background selection_foreground selection_background
  local color0 color3 color8

  eval "$(sed 's/ = /=/; s/"//g' "$COLORS_TOML")"

  local theme_dir="$HOME/.config/Typora/themes"
  mkdir -p "$theme_dir"

  printf '%s\n' \
    '/* Generated by the Omarchy theme-set hook. */' \
    ':root {' \
    "  --bg-color: $background;" \
    "  --text-color: $foreground;" \
    "  --primary-color: $accent;" \
    "  --primary-btn-border-color: $accent;" \
    "  --primary-btn-text-color: $background;" \
    "  --window-border: 1px solid $color0;" \
    "  --active-file-bg-color: $color0;" \
    "  --active-file-text-color: $foreground;" \
    "  --active-file-border-color: $accent;" \
    "  --side-bar-bg-color: $background;" \
    "  --item-hover-bg-color: $color0;" \
    "  --item-hover-text-color: $foreground;" \
    "  --control-text-color: $foreground;" \
    "  --control-text-hover-color: $accent;" \
    "  --search-select-bg-color: $color0;" \
    "  --search-select-text-color: $foreground;" \
    "  --select-text-bg-color: $selection_background;" \
    "  --select-text-font-color: $selection_foreground;" \
    "  --rawblock-edit-panel-bd: $color0;" \
    "  --monospace: 'JetBrains Mono', 'CaskaydiaMono Nerd Font', monospace;" \
    "  --background-color: $background;" \
    "  --font-color: $foreground;" \
    "  --header-color: $foreground;" \
    "  --light-header-color: $foreground;" \
    "  --accent-color: $color8;" \
    "  --accented-background-color: $color0;" \
    "  --border-color: $color0;" \
    "  --link-color: $accent;" \
    "  --code-bg-color: $color0;" \
    "  --hover-bg-color: $color0;" \
    "  --meta-content-color: $color8;" \
    "  --md-char-color: $color8;" \
    '}' \
    '' \
    'html,' \
    'body,' \
    '#write,' \
    '.typora-node {' \
    '  background: var(--bg-color);' \
    '  color: var(--text-color);' \
    '}' \
    '' \
    '#write {' \
    '  max-width: 920px;' \
    '}' \
    '' \
    'a,' \
    '.cm-link,' \
    '.md-link {' \
    '  color: var(--link-color);' \
    '}' \
    '' \
    'h1, h2, h3, h4, h5, h6 {' \
    '  color: var(--header-color);' \
    '}' \
    '' \
    'blockquote {' \
    '  border-left: 4px solid var(--primary-color);' \
    '  color: var(--font-color);' \
    '  background: var(--accented-background-color);' \
    '}' \
    '' \
    'code,' \
    'tt,' \
    '.md-fences,' \
    '.CodeMirror {' \
    '  background: var(--code-bg-color);' \
    '  color: var(--font-color);' \
    '}' \
    '' \
    'table tr,' \
    'table tr:nth-child(2n),' \
    'thead {' \
    '  background: var(--bg-color);' \
    '}' \
    '' \
    'th,' \
    'td {' \
    '  border-color: var(--border-color);' \
    '}' \
    '' \
    'mark {' \
    "  background: $color3;" \
    "  color: $background;" \
    '}' \
    '' \
    '.context-menu,' \
    '.megamenu-menu,' \
    '#typora-sidebar,' \
    '.typora-quick-open {' \
    '  background: var(--side-bar-bg-color);' \
    '  color: var(--text-color);' \
    '}' \
    '' \
    '.context-menu .menu-item:hover,' \
    '.file-list-item:hover,' \
    '.outline-item:hover {' \
    '  background: var(--hover-bg-color);' \
    '  color: var(--item-hover-text-color);' \
    '}' \
    '' \
    '.md-task-list-item > input:checked::before {' \
    '  color: var(--primary-color);' \
    '}' \
    >"$theme_dir/omarchy.css"
}

# ── Apply all ────────────────────────────────────────────────────────────────

update_zed
update_bat
update_delta
update_starship
update_zellij
update_sublime_merge
update_typora

# Deploy generated template outputs to app config dirs
deploy_template_output "bottom.toml" "$HOME/.config/bottom/bottom.toml"
deploy_template_output "yazi-theme.toml" "$HOME/.config/yazi/theme.toml"

# Apply generated hyprtasking label colors/effects to the active Hyprland session.
if command -v hyprctl >/dev/null 2>&1 && [[ -f "$THEME_DIR/hyprtasking-labels.conf" ]]; then
  sig=$(ls -1t /run/user/$UID/hypr/*/.socket.sock 2>/dev/null | head -n1 | xargs dirname | xargs basename)
  if [[ -n "$sig" ]]; then
    HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl keyword source "$THEME_DIR/hyprtasking-labels.conf" >/dev/null 2>&1 || true
  fi
fi
