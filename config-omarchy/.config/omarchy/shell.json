{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "io.github.gardnmi.window-shelf",
          "showWindowChips": false
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "crmne.omastats",
          "cpuStyle": "text",
          "modules": "cpu,memory,network,gpu,sensors",
          "gpuStyle": "text",
          "networkStyle": "text",
          "memoryStyle": "text",
          "barSensors": "cpu",
          "barLabels": "text",
          "showProcesses": true,
          "gpuTabVersion": 1,
          "tabs": "cpu,gpu,memory,disks,network,sensors,battery"
        },
        {
          "id": "io.github.douglas.omarchy-kefctl"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "neoshIconFontSize": 11,
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "version": 1,
  "plugins": []
}
