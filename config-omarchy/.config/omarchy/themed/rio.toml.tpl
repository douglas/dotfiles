# Rio colors from the current Omarchy theme (linked as ~/.config/rio/themes/omarchy.toml).
[colors]
background = "{{ background }}"
foreground = "{{ foreground }}"
cursor = "{{ bright_foreground }}"
vi-cursor = "{{ accent }}"
selection-background = "{{ selection_background }}"
selection-foreground = "{{ selection_foreground }}"
tabs = "{{ background }}"
tabs-foreground = "{{ muted }}"
tabs-active = "{{ accent }}"
tabs-active-foreground = "{{ background }}"
tabs-active-highlight = "{{ accent }}"
bar = "{{ background }}"
split = "{{ muted }}"
black = "{{ background }}"
red = "{{ red }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
blue = "{{ blue }}"
magenta = "{{ magenta }}"
cyan = "{{ cyan }}"
white = "{{ foreground }}"
light-black = "{{ muted }}"
light-red = "{{ bright_red }}"
light-green = "{{ bright_green }}"
light-yellow = "{{ bright_yellow }}"
light-blue = "{{ bright_blue }}"
light-magenta = "{{ bright_magenta }}"
light-cyan = "{{ bright_cyan }}"
light-white = "{{ bright_foreground }}"
