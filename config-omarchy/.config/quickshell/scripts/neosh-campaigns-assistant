#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CONFIG_DIR="$CONFIG_HOME/quickshell/campaigns-assistant"
STATE_DIR="$STATE_HOME/neosh/campaigns-assistant"
CONFIG_PATH="$CONFIG_DIR/config.json"
CAPTURE_PATH="$STATE_DIR/last_capture.json"
HISTORY_PATH="$STATE_DIR/history.json"
RESULT_PATH="$STATE_DIR/last_result.json"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"

make_temp_file() {
  local prefix="$1"
  local suffix="${2:-}"
  local dir path

  for dir in "${XDG_RUNTIME_DIR:-}" "$STATE_DIR" "${TMPDIR:-/tmp}"; do
    [[ -n "$dir" && -d "$dir" && -w "$dir" ]] || continue
    if path="$(mktemp "$dir/$prefix.XXXXXX$suffix" 2>/dev/null)"; then
      printf '%s\n' "$path"
      return 0
    fi
  done

  printf 'Unable to create temporary file for %s\n' "$prefix" >&2
  return 1
}

default_config() {
  jq -n '{
    runtime: "codex",
    model: "gpt-5.5",
    timeoutSeconds: 180,
    cwd: "/home/douglas/work/campaigns",
    historyLimit: 12
  }'
}

ensure_config() {
  if [[ ! -s "$CONFIG_PATH" ]]; then
    default_config > "$CONFIG_PATH"
  fi
}

read_config() {
  ensure_config
  if jq empty "$CONFIG_PATH" >/dev/null 2>&1; then
    cat "$CONFIG_PATH"
  else
    default_config
  fi
}

ensure_history() {
  if [[ ! -s "$HISTORY_PATH" ]] || ! jq empty "$HISTORY_PATH" >/dev/null 2>&1; then
    printf '[]\n' > "$HISTORY_PATH"
  fi
}

expand_path() {
  local value="${1:-$HOME}"
  case "$value" in
    "~") printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${value#"~/"}" ;;
    "\$HOME") printf '%s\n' "$HOME" ;;
    "\$HOME/"*) printf '%s/%s\n' "$HOME" "${value#"\$HOME/"}" ;;
    "") printf '%s\n' "$HOME" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

active_window_json() {
  hyprctl activewindow -j 2>/dev/null || printf '{}'
}

cursor_json() {
  hyprctl cursorpos -j 2>/dev/null || printf '{}'
}

primary_selection() {
  wl-paste --primary -n 2>/dev/null || true
}

clipboard_selection() {
  local old_path new_text had_old=0
  old_path="$(make_temp_file neosh-campaigns-clip)"
  if wl-paste -n > "$old_path" 2>/dev/null; then
    had_old=1
  fi

  wtype -M ctrl c -m ctrl >/dev/null 2>&1 || true
  sleep 0.08
  new_text="$(wl-paste -n 2>/dev/null || true)"

  if [[ "$had_old" -eq 1 ]]; then
    wl-copy < "$old_path" >/dev/null 2>&1 || true
  else
    wl-copy --clear >/dev/null 2>&1 || true
  fi
  rm -f "$old_path"
  printf '%s' "$new_text"
}

capture() {
  local text source window cursor
  text="$(primary_selection)"
  source="primary"
  if [[ -z "$text" ]]; then
    text="$(clipboard_selection)"
    source="clipboard"
  fi

  window="$(active_window_json)"
  cursor="$(cursor_json)"
  jq -n \
    --arg text "$text" \
    --arg source "$source" \
    --argjson window "$window" \
    --argjson cursor "$cursor" \
    '{ok: true, text: $text, source: $source, window: $window, cursor: $cursor}' |
    tee "$CAPTURE_PATH"
}

history() {
  ensure_history
  jq -n --slurpfile messages "$HISTORY_PATH" '{ok: true, messages: ($messages[0] // [])}'
}

clear_history() {
  printf '[]\n' > "$HISTORY_PATH"
  rm -f "$RESULT_PATH"
  history
}

append_history() {
  local role="$1"
  local text="$2"
  local limit="$3"
  local tmp created_at

  ensure_history
  tmp="$(make_temp_file neosh-campaigns-history)"
  created_at="$(date -Iseconds)"
  jq \
    --arg role "$role" \
    --arg text "$text" \
    --arg createdAt "$created_at" \
    --argjson limit "$limit" \
    '. + [{role: $role, text: $text, createdAt: $createdAt}] | .[-$limit:]' \
    "$HISTORY_PATH" > "$tmp"
  mv "$tmp" "$HISTORY_PATH"
}

compose_prompt() {
  local question="$1"
  local capture_json="$2"
  local history_json="$3"
  jq -n -r \
    --arg question "$question" \
    --argjson capture "$capture_json" \
    --argjson history "$history_json" \
    '[
      "You are Neo Campaigns Assistant for Doximity Campaigns.",
      "Answer as a senior engineer familiar with the Campaigns Rails codebase.",
      "Use the local /home/douglas/work/campaigns repository as the primary source of truth.",
      "Use configured MCP servers such as Glean or Slack when they are available and helpful.",
      "Do not edit files. Do not run destructive commands. Prefer read-only code inspection.",
      "When citing code, mention concrete paths, constants, classes, methods, or commands.",
      "If the selected text is a Slack thread or message, summarize what is happening, infer missing context from available tools/code, and suggest a concise reply when useful.",
      "If the selected text is code, explain the code path and relevant domain concepts.",
      "",
      "Current question:",
      $question,
      "",
      "Selected context:",
      "\"\"\"",
      ($capture.text // ""),
      "\"\"\"",
      "",
      "Recent transcript JSON:",
      ($history | tostring),
      "",
      "Return a concise but complete answer. Use bullets when they improve scanability."
    ] | join("\n")'
}

run_codex() {
  local model="$1"
  local cwd="$2"
  local timeout_seconds="$3"
  local prompt="$4"
  local output_path stderr_path status content

  output_path="$(make_temp_file neosh-campaigns-codex-output)"
  stderr_path="$(make_temp_file neosh-campaigns-codex-stderr)"
  status=0

  set +e
  printf '%s' "$prompt" | timeout "${timeout_seconds}s" codex --ask-for-approval never exec \
    --model "$model" \
    --cd "$cwd" \
    --sandbox read-only \
    --ephemeral \
    --output-last-message "$output_path" \
    - > /dev/null 2> "$stderr_path"
  status=$?
  set -e

  content="$(cat "$output_path" 2>/dev/null || true)"
  if [[ "$status" -ne 0 ]]; then
    jq -n \
      --arg stderr "$(cat "$stderr_path" 2>/dev/null || true)" \
      --argjson status "$status" \
      '{ok: false, error: ($stderr | if length > 0 then . else "codex command failed" end), status: $status}'
  else
    jq -n --arg answer "$content" '{ok: true, answer: $answer}'
  fi

  rm -f "$output_path" "$stderr_path"
}

run_claude() {
  local model="$1"
  local cwd="$2"
  local timeout_seconds="$3"
  local prompt="$4"
  local system_path output_path stderr_path status

  system_path="$(make_temp_file neosh-campaigns-claude-system .md)"
  output_path="$(make_temp_file neosh-campaigns-claude-output)"
  stderr_path="$(make_temp_file neosh-campaigns-claude-stderr)"
  printf '%s\n' "You are Neo Campaigns Assistant. Use Campaigns code and configured MCPs for read-only answers." > "$system_path"
  status=0

  set +e
  cd "$cwd" && printf '%s' "$prompt" | timeout "${timeout_seconds}s" claude -p \
    --model "$model" \
    --permission-mode dontAsk \
    --no-session-persistence \
    --add-dir "$cwd" \
    --input-format text \
    --output-format text \
    --system-prompt-file "$system_path" \
    > "$output_path" 2> "$stderr_path"
  status=$?
  set -e

  if [[ "$status" -ne 0 ]]; then
    jq -n \
      --arg stderr "$(cat "$stderr_path" 2>/dev/null || true)" \
      --argjson status "$status" \
      '{ok: false, error: ($stderr | if length > 0 then . else "claude command failed" end), status: $status}'
  else
    jq -n --arg answer "$(cat "$output_path" 2>/dev/null || true)" '{ok: true, answer: $answer}'
  fi

  rm -f "$system_path" "$output_path" "$stderr_path"
}

ask() {
  local question="${1:-}"
  local config runtime model timeout_seconds cwd history_limit capture_json history_json prompt result answer

  if [[ -z "$question" ]]; then
    jq -n '{ok: false, error: "missing question"}'
    return 2
  fi

  config="$(read_config)"
  runtime="$(printf '%s' "$config" | jq -r '.runtime // "codex"')"
  model="$(printf '%s' "$config" | jq -r '.model // "gpt-5.5"')"
  timeout_seconds="$(printf '%s' "$config" | jq -r '.timeoutSeconds // 180')"
  history_limit="$(printf '%s' "$config" | jq -r '.historyLimit // 12')"
  cwd="$(expand_path "$(printf '%s' "$config" | jq -r '.cwd // "/home/douglas/work/campaigns"')")"
  [[ -d "$cwd" ]] || cwd="/home/douglas/work/campaigns"
  [[ -d "$cwd" ]] || cwd="$HOME"

  if [[ ! -s "$CAPTURE_PATH" ]]; then
    capture >/dev/null
  fi

  ensure_history
  capture_json="$(cat "$CAPTURE_PATH" 2>/dev/null || printf '{}')"
  history_json="$(cat "$HISTORY_PATH")"
  prompt="$(compose_prompt "$question" "$capture_json" "$history_json")"
  append_history "user" "$question" "$history_limit"

  case "$runtime" in
    codex)
      result="$(run_codex "$model" "$cwd" "$timeout_seconds" "$prompt")"
      ;;
    claude)
      result="$(run_claude "$model" "$cwd" "$timeout_seconds" "$prompt")"
      ;;
    *)
      result="$(jq -n --arg runtime "$runtime" '{ok: false, error: "unsupported runtime: " + $runtime}')"
      ;;
  esac

  answer="$(printf '%s' "$result" | jq -r '.answer // empty')"
  if [[ -n "$answer" ]]; then
    append_history "assistant" "$answer" "$history_limit"
  fi

  history_json="$(cat "$HISTORY_PATH")"
  printf '%s\n' "$result" |
    jq --argjson messages "$history_json" '. + {messages: $messages}' |
    tee "$RESULT_PATH"
}

copy_last() {
  if [[ ! -s "$RESULT_PATH" ]]; then
    jq -n '{ok: false, error: "no answer to copy"}'
    return 2
  fi

  jq -r '.answer // empty' "$RESULT_PATH" | wl-copy
  jq -n '{ok: true}'
}

case "${1:-}" in
  capture) capture ;;
  history) history ;;
  clear) clear_history ;;
  ask) shift; ask "$*" ;;
  copy-last) copy_last ;;
  config-path) printf '%s\n' "$CONFIG_PATH" ;;
  *)
    printf 'usage: neosh-campaigns-assistant capture|history|clear|ask <question>|copy-last|config-path\n' >&2
    exit 2
    ;;
esac
