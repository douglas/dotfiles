# kitty session for Ctrl+K \ (keys.conf): one tab with a shell on every home
# machine, in four equal quarters, like herdr-app's machines mod:
#   desktop | t1g
#   --------+-----
#   mbp16   | t14s
# The grid layout fills column by column, hence the launch order. Each window
# runs machine-shell: a login shell on its own machine, SSH to the others.
new_tab machines
layout grid
launch --title desktop sh -c 'exec "$HOME/.bin/machine-shell" desktop'
launch --title mbp16 sh -c 'exec "$HOME/.bin/machine-shell" mbp16'
launch --title t1g sh -c 'exec "$HOME/.bin/machine-shell" t1g'
launch --title t14s sh -c 'exec "$HOME/.bin/machine-shell" t14s'
